# Copy to .env for local overrides. Never commit a real .env.

PORT=3000

# All ordering deadlines are evaluated in this timezone, not the server's
# and not the guest's browser.
HOTEL_TZ=Europe/Moscow

VAT_PERCENT=20

# Required in production — the app refuses to start without them.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
STAFF_SESSION_SECRET=

DB_PATH=data/dining.db

# 'off' disables the demo-guest prefill endpoint, which reveals a seeded
# guest's login details. Must be off for any real deployment.
DEMO_MODE=on

# --- Deployment-only knobs -------------------------------------------------

# 'on' wipes and re-seeds the demo database once a day, so a public demo
# never fills with strangers' test orders and always has a live menu.
DEMO_RESET=off
DEMO_RESET_HOUR=4

# 'on' tells the UI to warn visitors that the host sleeps when idle, so a
# 40-second cold start reads as "starting up" rather than "broken".
# Set this only if it is actually true of your host.
HOST_SLEEPS=off

# Ceiling on stored orders for a public instance; the oldest beyond it are
# dropped, and their line items go with them. 0 disables the cap, which is
# what a real hotel wants.
MAX_ORDERS=200

# --- Turso (a persistent database on a host with no disk) -------------------
#
# SQLite is a file, so a host without a volume forgets everything on redeploy.
# Turso hosts the file remotely and libsql speaks the same synchronous API,
# so the application code is unchanged — only these variables differ.
#
#   npm i -g @tursodatabase/turso-cli   (or: curl -sSfL https://get.tur.so/install.sh | bash)
#   turso auth signup
#   turso db create in-room-dining
#   turso db show in-room-dining --url
#   turso db tokens create in-room-dining
#
DB_DRIVER=better-sqlite3

# Embedded replica: a local cache kept in sync with Turso. Fast reads, and the
# durable copy is remote. Preferred.
TURSO_SYNC_URL=
TURSO_SYNC_SECONDS=60

# Or talk to Turso directly with no local file. Simpler, one network round
# trip per query. Set this OR TURSO_SYNC_URL, never both.
TURSO_DATABASE_URL=

TURSO_AUTH_TOKEN=
